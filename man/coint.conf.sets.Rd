\deqn{\begin{aligned}
y_t & = \beta_{b,c} + \beta_{b,\tau} t + z_{b,t}'\beta_{b,z}
  + \mathrm{1}(t > [\lambda_0 T])\left(\delta_{b,c} + \delta_{b,\tau} t + z_{b,t}'\delta_{b,z}\right)
  + z_{f,t}'\beta_{f,z} + {}\\
  & \quad + \sum_{j=-nL}^{nF} \pi_{b,j}'\Delta z_{b,t-j}
